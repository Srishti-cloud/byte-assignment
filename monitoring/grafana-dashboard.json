{
  "title": "8Byte Assignment Overview",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Request Rate",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [{ "expr": "rate(http_requests_total[5m])", "legendFormat": "requests/sec" }]
    },
    {
      "type": "stat",
      "title": "Error Rate",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [{ "expr": "rate(http_requests_total{status=~\"5..\"}[5m])", "legendFormat": "5xx/sec" }]
    },
    {
      "type": "stat",
      "title": "P95 Latency",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_ms_bucket[5m])) by (le))", "legendFormat": "p95" }]
    },
    {
      "type": "stat",
      "title": "Database Connections",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "targets": [{ "expr": "pg_stat_activity_count" }]
    }
  ]
}
